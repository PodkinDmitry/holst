 /* End CHAT 02 style bundle */
+
+
+/* CHAT 03 — optional named view presets. Standalone scoped addition for Sol. */
+.yt-table300__presets { border: 1px solid var(--yt300-line); border-radius: .55rem;
+  background: var(--yt300-tint); padding: .65rem .8rem; margin: .45rem 0 .8rem; min-width: 0; }
+.yt-table300__preset-heading { font-size: 1em; font-weight: 650; margin: 0 0 .55rem; }
+.yt-table300__preset-controls { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .6rem; }
+.yt-table300__preset-control { display: grid; gap: .2rem; min-width: 0; }
+.yt-table300__preset-control > span { font-size: .9em; }
+.yt-table300__presets select, .yt-table300__presets input, .yt-table300__preset-button {
+  font: inherit; color: inherit; background: Canvas; color: CanvasText; border: 1px solid var(--yt300-line);
+  border-radius: .4rem; padding: .4rem .55rem; min-height: 2.3rem; min-width: 0; max-width: 100%; }
+.yt-table300__preset-actions { display: flex; flex-wrap: wrap; gap: .4rem; margin: .6rem 0 .35rem; }
+.yt-table300__preset-button { cursor: pointer; background: var(--yt300-tint); color: inherit; }
+.yt-table300__preset-button:not(:disabled):hover { background: var(--yt300-hover); }
+.yt-table300__preset-button:disabled { cursor: default; opacity: .48; }
+.yt-table300__preset-status { margin: .35rem 0 0; font-size: .92em; overflow-wrap: anywhere; }
+.yt-table300__preset-status:empty { display: none; }
+.yt-table300__preset-empty { margin: .35rem 0; opacity: .75; font-size: .92em; }
+.yt-table300__preset-retry { margin-top: .35rem; }
+.yt-table300__preset-empty[hidden], .yt-table300__preset-retry[hidden] { display: none; }
+@media (max-width: 680px) { .yt-table300__preset-controls { grid-template-columns: minmax(0,1fr); }
+  .yt-table300__preset-actions .yt-table300__preset-button { flex: 1 1 9rem; } }